# Entry point domain utama
DirectoryIndex index.php portofolio_3d_isometric_achmad_febri.html index.html

# Matikan directory listing
Options -Indexes

# Blokir akses langsung ke folder internal (.git, .agents)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(git|agents)(/|$) - [F,L]
</IfModule>

# Blokir akses langsung ke file tersembunyi (.htaccess, .gitignore, .env, dll.)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Blokir file dokumentasi & metadata internal
<FilesMatch "(?i)^(README\.md|skills-lock\.json|composer\.(json|lock)|package(-lock)?\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Security Headers dasar untuk seluruh halaman
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>
